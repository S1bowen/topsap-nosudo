# topsap.env -- site settings.  Copy to ~/topsap/topsap.env and edit.
#
#   cp topsap.env.example ~/topsap/topsap.env && chmod 600 ~/topsap/topsap.env
#
# Nothing here is secret except the password, and the password does not belong
# in this file if you can avoid it: use TOPSAP_PWD in the environment, or
# ~/topsap/.pwd (mode 600), which vpnup.sh reads when neither is set.
#
# This file is sourced by bin/vpnup.sh and bin/twofa.sh.  It is NOT read by
# bin/topsap itself; variables that the driver needs (TOPSAP_PROXY_TARGET,
# TOPSAP_PROXY_PORT, TOPSAP_ROOT) must be exported in your shell.
#
# Every value below can also be given in the environment, which wins.

# --- gateway ---------------------------------------------------------------
# Address and port of the VPN gateway's SSL-VPN service.
TOPSAP_HOST=vpn.example.com
TOPSAP_PORT=443

# --- account ---------------------------------------------------------------
# The VPN user name, exactly as the gateway knows it.
TOPSAP_USER=your-vpn-account

# --- optional checks, run after a successful login ------------------------
# An address that should become reachable through the tunnel (TCP 22 and 23
# are probed), e.g. the jump host inside the VPN.
#TOPSAP_TARGET=10.0.0.4

# An ~/.ssh/config alias that should authenticate through the tunnel.  Leave
# empty if you have not written the ssh config yet.
#TOPSAP_TEST_HOST=vpn-login

# --- reverse proxy (topsap proxy / pxcheck) -------------------------------
# The alias that carries `RemoteForward <port> <this machine's proxy>`.
# Optional: when unset, the driver finds the host whose config carries
# `RemoteForward <port> ...` and uses that (set it only to override).
#TOPSAP_PROXY_TARGET=vpn-remote

# The port published on the far side.  Must equal the first argument of that
# RemoteForward line.
#TOPSAP_PROXY_PORT=18438

# --- password (optional; prefer the environment or ~/.pwd) ----------------
#TOPSAP_PWD=
